# Copy this file to .env and fill in values. NEVER commit .env.

# --- Database ---
# Local default is a SQLite file. In production use the Supabase Postgres URL.
DATABASE_URL=sqlite:///./schoolconnect.db

# --- AI provider ---
# rules (default, offline, no key) | anthropic | gemini
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15

# --- API security ---
# If set, endpoints that write data or return personal data require the header
# X-API-Key: <value>. Leave empty to disable locally.
API_KEY=
# Week 5: required to call /jobs/* endpoints (header X-Jobs-Token). Jobs are disabled if empty.
JOBS_TOKEN=

# Week 6 (POPIA): resolved tickets older than this many days are anonymised by the retention job.
RETENTION_DAYS=365

# --- Week 7: staff login ---
# PBKDF2-SHA256 iterations for staff passwords (OWASP 2023+ advice: 600000). Create accounts with
#   python scripts/create_staff.py --name "..." --email ... --role ...
PASSWORD_HASH_ITERATIONS=600000

# --- Week 7: notifications (outbox) ---
# dry_run (default): every notification is written to the outbox table and NOTHING is sent.
# smtp: email is really sent with the settings below (port 587 + STARTTLS).
# Phone numbers are recorded as "not_supported" (no SMS/WhatsApp yet).
NOTIFY_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:8501

# --- Frontend (Streamlit) ---
# The frontend reads these from env vars or .streamlit/secrets.toml.
# API_KEY above must match on both sides when it is set.
API_BASE_URL=http://localhost:8000
